{
  "manifest_version": 3,
  "name": "WA Business Blur - By Geraldine",
  "version": "1.1",
  "description": "Satu klik untuk blur seluruh WhatsApp Web.",
  "permissions": ["storage"],
  
  "icons": {
    "128": "icon.png"
  },
  
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  
  "content_scripts": [
    {
      "matches": ["*://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}